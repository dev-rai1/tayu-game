# Backend environment. Copy to .env and fill in. Never commit the real .env.

PORT=4000
NODE_ENV=development

# CORS origin for the frontend (local dev shown; prod = https://tayu.vercel.app)
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# Firebase Admin — paste the service-account JSON as a single-line string,
# OR set GOOGLE_APPLICATION_CREDENTIALS to a key file path (gitignored).
FIREBASE_ADMIN_KEY=
FIREBASE_DATABASE_URL=

SESSION_TIMEOUT_MINUTES=60
MAX_PLAYERS_PER_SESSION=15
