rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function profileExists(userId) { return exists(/databases/$(database)/documents/profiles/$(userId)); }
    function profileRole(userId) { return profileExists(userId) ? get(/databases/$(database)/documents/profiles/$(userId)).data.role : null; }
    function isDashboardViewer() { return signedIn() && request.auth.token.email == 'dashboard.viewer.v3@tayufinance.app'; }
    function isAdmin() { return signedIn() && !isDashboardViewer() && profileRole(request.auth.uid) == 'admin'; }
    function isTeacher() { return signedIn() && profileRole(request.auth.uid) == 'teacher'; }
    function canReadDashboard() { return isAdmin() || isDashboardViewer(); }
    function validPublicRole(role) { return role == 'student' || role == 'teacher' || role == 'other'; }
    function validProfileRole(role) { return validPublicRole(role) || (isDashboardViewer() && role == 'admin'); }
    function validAuthActivityType(type) { return type == 'sign_up' || type == 'sign_in' || type == 'sign_out'; }
    function validGuestUsage() {
      return request.resource.data.guest == true
        && request.resource.data.role == 'guest'
        && request.resource.data.uid is string
        && request.resource.data.uid.matches('guest_[A-Za-z0-9_]+')
        && request.resource.data.email == ''
        && request.resource.data.sessionId is string
        && request.resource.data.startedAt is string
        && request.resource.data.lastSeenAt is string
        && request.resource.data.durationSeconds is number
        && request.resource.data.path is string
        && request.resource.data.currentModule is string
        && request.resource.data.moduleSeconds is map
        && request.resource.data.device is string;
    }
    function teacherOwnsStudent(studentId) {
      return isTeacher()
        && profileExists(studentId)
        && get(/databases/$(database)/documents/profiles/$(studentId)).data.teacherId == request.auth.uid;
    }

    match /profiles/{userId} {
      allow create: if owns(userId)
        && request.resource.data.email == request.auth.token.email
        && validProfileRole(request.resource.data.role);
      allow get: if owns(userId) || canReadDashboard() || teacherOwnsStudent(userId);
      allow list: if canReadDashboard() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() || (
        owns(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    match /progress/{userId} {
      allow read: if owns(userId) || canReadDashboard() || teacherOwnsStudent(userId);
      allow create, update: if owns(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /classes/{teacherId} {
      allow create, update, delete: if owns(teacherId) && isTeacher();
      allow read: if signedIn();
    }

    match /authActivity/{activityId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && validAuthActivityType(request.resource.data.type);
      allow get: if canReadDashboard() || (signedIn() && resource.data.uid == request.auth.uid) || teacherOwnsStudent(resource.data.uid);
      allow list: if canReadDashboard() || (isTeacher() && teacherOwnsStudent(resource.data.uid));
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /usageSessions/{sessionId} {
      allow create, update: if (signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email)
        || validGuestUsage();
      allow read: if canReadDashboard() || (signedIn() && resource.data.uid == request.auth.uid) || teacherOwnsStudent(resource.data.uid);
      allow delete: if isAdmin();
    }

    match /sitePageViews/{viewId} {
      allow create: if request.resource.data.visitorId is string
        && request.resource.data.sessionId is string
        && request.resource.data.path is string
        && request.resource.data.viewedAt is string;
      allow read: if canReadDashboard();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
