rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function validPublicRole(role) {
      return role == 'student' || role == 'teacher' || role == 'other';
    }

    match /profiles/{userId} {
      allow create: if owns(userId)
        && request.resource.data.email == request.auth.token.email
        && validPublicRole(request.resource.data.role);
      allow read: if owns(userId) || isAdmin();
      allow update: if isAdmin() || (
        owns(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    match /progress/{userId} {
      allow read, create, update: if owns(userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
